#!/usr/bin/env python3
"""Stable CLI entrypoint for the VOS Fabric generic worker adapter."""

import importlib.util
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
MODULE_PATH = REPO_ROOT / "components" / "fabric" / "worker_adapter.py"

spec = importlib.util.spec_from_file_location("vos_fabric_worker_adapter", str(MODULE_PATH))
if spec is None or spec.loader is None:
    raise SystemExit("cannot load VOS Fabric worker adapter")
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

raise SystemExit(module.main(sys.argv))
