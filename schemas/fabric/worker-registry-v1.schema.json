{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vos.local/schemas/fabric/worker-registry-v1.schema.json",
  "title": "VOS Fabric Worker Registry v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "worker_id",
      "provider",
      "model_id",
      "kind",
      "credential_domain",
      "qualification_ref",
      "data_policy_ref",
      "data_classes",
      "data_policy",
      "network",
      "max_cost_usd",
      "zero_cost_hard_stop",
      "consumer_oauth_proxy",
      "enabled",
      "priority"
    ],
    "properties": {
      "worker_id": {"type": "string", "minLength": 1},
      "provider": {"type": "string", "minLength": 1},
      "model_id": {"type": "string", "minLength": 1},
      "kind": {
        "enum": ["DIRECT_OFFICIAL", "LOCAL_DETERMINISTIC", "RESTRICTED_GATEWAY"]
      },
      "credential_domain": {"type": "string", "minLength": 1},
      "qualification_ref": {"type": "string", "minLength": 1},
      "data_policy_ref": {"type": "string", "minLength": 1},
      "data_classes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SECRET"]}
      },
      "data_policy": {"enum": ["PUBLIC_ONLY", "NO_TRAINING", "ZDR", "LOCAL_ONLY"]},
      "network": {"enum": ["NONE", "VOS_AUTHORIZED"]},
      "max_cost_usd": {"type": "number", "const": 0},
      "zero_cost_hard_stop": {"const": true},
      "consumer_oauth_proxy": {"const": false},
      "enabled": {"type": "boolean"},
      "priority": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "PUBLIC": {"type": "integer", "minimum": 0},
          "INTERNAL": {"type": "integer", "minimum": 0},
          "CONFIDENTIAL": {"type": "integer", "minimum": 0},
          "SECRET": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
